"""
Every rail from two raw inputs (+5 V and -5 V on the Mini-Fit Jr), each through its own
ultralow-noise regulator, so the bench supply's noise stops here:

- VDD_A, VDD_D, VDD_DAC, VDD_IO: 1.2 V for the chip, one LT3045 each. Each rail has a three-pin
  header: a jumper on 1-2 takes the regulator, on 2-3 the matching pin of J_EXT, where a lab
  supply can drive the rail as on frida-scc-1p1 (for supply sweeps).
- V3P3A: 3.3 V for the amplifier's positive supply, the reference and the DAC.
- V2P5: 2.5 V for the probe matrix and the control logic (the FPGA's levels).
- VS_N: -1.5 V for the amplifier's and the buffer's negative supply, an LT3094.

frida-scc-1p1 took 1.2 V, V+ and V- straight from the bench on this connector; here pin 3 (its
V+) is the +5 V input, pin 1 (its V-) the -5 V input and pin 4 (its 1.2 V) is unused.
"""

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")
PinHeader = Module("@stdlib/generics/PinHeader.zen")
MiniFit = Module("../components/MiniFitJr_Molex_469990014/MiniFitJr_Molex_469990014.zen")
Regulator = Module("Regulator.zen")
NegRegulator = Module("NegRegulator.zen")

VDD_A = io(Power)
VDD_D = io(Power)
VDD_DAC = io(Power)
VDD_IO = io(Power)
V3P3A = io(Power)
V2P5 = io(Power)
VS_N = io(Power)
GND = io(Ground)

# Probe nodes: each chip rail's load current (3 mV per mA) and the two rails beyond the probe
# matrix's 0 to 2 V range, halved
IMON_A = io(Net)
IMON_D = io(Net)
IMON_DAC = io(Net)
IMON_IO = io(Net)
MON_V3P3A = io(Net, help="V3P3A / 2")
MON_VS_N = io(Net, help="(V3P3A + VS_N) / 2")

# ---------------------------------------------------------------- raw inputs

V5P_RAW = Power("V5P_RAW")
V5N_RAW = Power("V5N_RAW")
V5P = Power("V5P", voltage="5V")
V5N = Power("V5N")

MiniFit(name="J_PWR", P1=V5N_RAW, P2=GND, P3=V5P_RAW, P4=NotConnected())

FerriteBead(name="FB_P", package="0603", P1=V5P_RAW, P2=V5P)
FerriteBead(name="FB_N", package="0603", P1=V5N_RAW, P2=V5N)
Capacitor(name="C_P_BULK", value="47uF", package="1210", voltage="16V", P1=V5P, P2=GND)
Capacitor(name="C_N_BULK", value="47uF", package="1210", voltage="16V", P1=V5N, P2=GND)

# ---------------------------------------------------------------- the chip's four 1.2 V rails

EXT = {name: Net("EXT_" + name) for name in ["A", "D", "DAC", "IO"]}

for name, rail, imon in [
    ("A", VDD_A, IMON_A),
    ("D", VDD_D, IMON_D),
    ("DAC", VDD_DAC, IMON_DAC),
    ("IO", VDD_IO, IMON_IO),
]:
    reg_out = Power("VREG_" + name, voltage="1.2V")
    Regulator(name="REG_" + name, vout="1.2V", VIN=V5P, VOUT=reg_out, GND=GND, IMON=imon)
    PinHeader(name="J_SEL_" + name, pins=3, rows=1, mount="THT", P1=reg_out, P2=rail, P3=EXT[name])

PinHeader(
    name="J_EXT",
    pins=4,
    rows=2,
    mount="THT",
    P1=EXT["A"],
    P2=GND,
    P3=EXT["D"],
    P4=GND,
    P5=EXT["DAC"],
    P6=GND,
    P7=EXT["IO"],
    P8=GND,
)

# ---------------------------------------------------------------- board rails

Regulator(name="REG_3V3A", vout="3.3V", VIN=V5P, VOUT=V3P3A, GND=GND)
Regulator(name="REG_2V5", vout="2.5V", VIN=V5P, VOUT=V2P5, GND=GND)
NegRegulator(name="REG_VS_N", vout_magnitude="1.5V", VIN=V5N, VOUT=VS_N, GND=GND)

Resistor(name="R_MON_3V3A_TOP", value="10k", package="0402", P1=V3P3A, P2=MON_V3P3A)
Resistor(name="R_MON_3V3A_BOT", value="10k", package="0402", P1=MON_V3P3A, P2=GND)
Resistor(name="R_MON_VS_N_TOP", value="10k", package="0402", P1=V3P3A, P2=MON_VS_N)
Resistor(name="R_MON_VS_N_BOT", value="10k", package="0402", P1=MON_VS_N, P2=VS_N)
