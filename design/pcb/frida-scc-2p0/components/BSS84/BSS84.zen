    name="BSS84",
    footprint=File("SOT-23.kicad_mod"),
    part=Part(mpn="BSS84", manufacturer="onsemi"),
    properties={"Value": "BSS84", "schematic_description": "P-MOSFET transistor, gate/source/drain"},
    symbol=Symbol(library="BSS84.kicad_sym"),
    pin_defs={"G": "1", "S": "2", "D": "3"},
    pins={"G": G, "S": S, "D": D},
)
