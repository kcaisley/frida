"""
LT3045: 500 mA ultralow-noise, ultrahigh-PSRR linear regulator, MSOP-12 (output = 100 uA x R_SET).
"""

IN = io(Power)
EN_UV = io(Net)
PGFB = io(Net)
ILIM = io(Net)
GND = io(Ground)
OUT = io(Power)
OUTS = io(Net)
SET = io(Net)
PG = io(Net)

Component(
    name="LT3045",
    symbol=Symbol(library="LT3045.kicad_sym"),
    footprint=File("MSOP-12-1EP_3x4.039mm_P0.65mm_EP1.651x2.845mm.kicad_mod"),
    part=Part(mpn="LT3045EMSE#PBF", manufacturer="Analog Devices"),
    prefix="U",
    pins={
        "IN_1": IN,
        "IN_2": IN,
        "IN_3": IN,
        "EN_UV": EN_UV,
        "PGFB": PGFB,
        "ILIM": ILIM,
        "GND_9": GND,
        "GND_13": GND,
        "OUT_11": OUT,
        "OUT_12": OUT,
        "OUTS": OUTS,
        "SET": SET,
        "PG": PG,
    },
)
